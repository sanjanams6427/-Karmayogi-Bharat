# ============================================================
# KB Translation System — Environment Configuration
# RFB IN-KBL-543730-NC-RFB | iGOT Karmayogi
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── HuggingFace Token (REQUIRED for model downloads) ─────────
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sovereign Mode (REQUIRED for government content) ─────────
# When enabled, all foreign cloud APIs (Groq/Gemini/OpenRouter) are blocked.
# This is the DEFAULT for iGOT Karmayogi / government content.
# Set to 0 ONLY for non-government content.
KB_SOVEREIGN_MODE=1

# ── CBP Portal Upload (optional) ─────────────────────────────
# Credentials for automated upload to CBP portal (KB tender §4.2)
# CBP_USERNAME=your_cbp_username
# CBP_PASSWORD=your_cbp_password

# ── LLM Post-Edit Enhancement (optional, blocked in sovereign mode) ──
# These are ONLY used when KB_SOVEREIGN_MODE=0
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Output Directory (optional) ──────────────────────────────
# Default: ./output
# OUTPUT_DIR=/path/to/custom/output

# ── Logging (optional) ───────────────────────────────────────
# LOG_LEVEL=INFO
